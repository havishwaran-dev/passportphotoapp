# =========================================================================
# PJK Passport Photo Automation Studio - .gitignore
# =========================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & local secrets
.env
.env.local
.env.*.local

# Local application storage & temp directories (preserve folder structure via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep
backend/temp/*
!backend/temp/.gitkeep

# Local operator settings & history (auto-generated at runtime)
backend/app/config/settings.json
backend/app/config/history.json

# Node & Frontend dependencies and production build
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# AI Models & weights cache
models/*.onnx
models/*.pth
models/*.bin
.u2net/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo

