# PJK Passport Photo Automation Studio Configuration
# Copy this file to .env or configure settings directly through the Web UI Settings tab

# Photoshop executable path (defaults to auto-detected local installation)
PHOTOSHOP_PATH=C:\Program Files\Adobe\Adobe Photoshop CS6 (x64)\Photoshop.exe

# Action file and action set configuration
ACTION_FILE_PATH=C:\FreePro\passportphotoapp\PJK.atn
ACTION_SET_NAME=PJK
ACTION_NAME=passport

# Default passport photo physical dimensions & resolution
PASSPORT_WIDTH_MM=35.0
PASSPORT_HEIGHT_MM=45.0
RESOLUTION_DPI=300
JPEG_QUALITY=95

# Default solid background color for passport photos (HEX)
DEFAULT_BG_COLOR=#0080FF

# 4x6 Sheet default configuration
SHEET_ORIENTATION=landscape
SHEET_SPACING_MM=3.0
SHEET_MARGIN_MM=4.0
SHEET_CUTTING_GUIDES=true

# Storage directories
UPLOAD_FOLDER=backend/uploads
OUTPUT_FOLDER=backend/outputs
TEMP_FOLDER=backend/temp

